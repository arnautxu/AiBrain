# Non-secret per-installation Compose values.
AIBRAIN_COMPOSE_PROJECT_NAME=aibrain-company-qa
AIBRAIN_IMAGE=aibrain-company-qa:replace-with-git-sha
AIBRAIN_RUNTIME_ENV_FILE=./aibrain.env.example
AIBRAIN_INSTALLATION_CONFIG_HOST=./installation.qa.example.json
AIBRAIN_SOURCE_HOST_PATH=/srv/aibrain-company-qa/source-ro
AIBRAIN_PUBLISH_HOST_PATH=/srv/aibrain-company-qa/publish-rw
AIBRAIN_NETWORK_NAME=aibrain-company-qa-private
AIBRAIN_DATA_VOLUME_NAME=aibrain-company-qa-data
AIBRAIN_BACKUP_VOLUME_NAME=aibrain-company-qa-backups
AIBRAIN_RESTORE_VOLUME_NAME=aibrain-company-qa-restores
AIBRAIN_BIND_ADDRESS=127.0.0.1
AIBRAIN_HTTP_PORT=3100
AIBRAIN_UID=10001
AIBRAIN_GID=10001
AIBRAIN_CODEX_VERSION=0.149.1
AIBRAIN_CPU_LIMIT=2.0
AIBRAIN_MEMORY_LIMIT=4g
AIBRAIN_MEMORY_RESERVATION=1g
AIBRAIN_PIDS_LIMIT=768
AIBRAIN_SHM_SIZE=1g
AIBRAIN_TMP_SIZE=512m
AIBRAIN_NEXT_CACHE_SIZE=256m
AIBRAIN_NOFILE_SOFT=8192
AIBRAIN_NOFILE_HARD=16384
AIBRAIN_LOG_MAX_SIZE=10m
AIBRAIN_LOG_MAX_FILES=5
AIBRAIN_LOG_BUFFER_SIZE=4m
AIBRAIN_TIMEZONE=Europe/Madrid
