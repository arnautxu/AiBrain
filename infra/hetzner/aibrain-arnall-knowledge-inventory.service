[Unit]
Description=Private resumable Arnall knowledge catalogue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/aibrain/knowledge/knowledge-inventory.py --manifest /etc/aibrain/company-qa/rdp/server-files.json --priority-manifest /etc/aibrain/company-qa/rdp/sync.json --rescan-after 86400 --max-pages 10 --seconds 240
ExecStartPost=/usr/bin/python3 /usr/local/lib/aibrain/knowledge/knowledge-reconcile.py --manifest /etc/aibrain/company-qa/rdp/server-files.json --bindings /etc/aibrain/company-qa/rdp/knowledge-bindings.json --max-files 2
ExecStartPost=/usr/bin/python3 /usr/local/lib/aibrain/knowledge/knowledge-ingest.py --manifest /etc/aibrain/company-qa/rdp/server-files.json --priority-manifest /etc/aibrain/company-qa/rdp/sync.json --max-files 10 --seconds 120
ExecStartPost=/usr/bin/python3 /usr/local/lib/aibrain/knowledge/knowledge-publish.py --manifest /etc/aibrain/company-qa/rdp/server-files.json --bindings /etc/aibrain/company-qa/rdp/knowledge-bindings.json
TimeoutStartSec=1200
TimeoutStopSec=15
KillMode=control-group
Nice=10
CPUQuota=50%
MemoryMax=1G
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/aibrain/knowledge /var/lib/aibrain/rdp-imports/arnall
