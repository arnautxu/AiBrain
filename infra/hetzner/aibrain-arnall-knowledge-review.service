[Unit]
Description=Authenticated human review of scoped Arnall knowledge proposals
After=docker.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/aibrain/knowledge/knowledge-review.py --manifest /etc/aibrain/company-qa/rdp/server-files.json --bindings /etc/aibrain/company-qa/rdp/knowledge-bindings.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
KillMode=control-group
CPUQuota=25%
MemoryMax=512M
TasksMax=32
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/aibrain/knowledge/company-qa/partitions /var/lib/docker/volumes/aibrain-company-qa-data/_data/locks/knowledge-review

[Install]
WantedBy=multi-user.target
