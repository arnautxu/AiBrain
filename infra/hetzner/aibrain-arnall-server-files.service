[Unit]
Description=Read-only server file browsing for Arnall
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/aibrain/server-files/rdp-server-files-broker.py --manifest /etc/aibrain/company-qa/rdp/server-files.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
MemoryMax=1G
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Bubblewrap uses NETLINK_ROUTE to initialize loopback inside its isolated
# network namespace. The extractor still has no external network interface.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/aibrain/rdp-imports/arnall
ReadWritePaths=/var/lib/docker/volumes/aibrain-company-qa-data/_data/locks/server-files
ReadWritePaths=/var/lib/aibrain/knowledge/company-qa/operator
ReadWritePaths=/var/lib/aibrain/knowledge/company-qa/server-map

[Install]
WantedBy=multi-user.target
