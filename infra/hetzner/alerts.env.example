AIBRAIN_ALERT_SINK=webhook
AIBRAIN_ALERT_WEBHOOK_URL=https://alerts.example.invalid/aibrain
AIBRAIN_ALERT_WEBHOOK_TOKEN=replace-with-a-dedicated-random-token
AIBRAIN_ALERT_WEBHOOK_TIMEOUT_MS=10000
AIBRAIN_ALERT_INTERVAL_SECONDS=60
AIBRAIN_ALERT_MAX_PENDING=1000
AIBRAIN_ALERT_MAX_ATTEMPTS=5
AIBRAIN_ALERT_DISPATCH_LIMIT=25
AIBRAIN_ALERT_PENDING_WARN_AGE_MS=900000
AIBRAIN_ALERT_READINESS_URL=http://app:3000/api/health/ready
AIBRAIN_ALERT_EGRESS_READINESS_URL=http://egress-gateway:8080/__aibrain_egress_health
AIBRAIN_ALERT_EGRESS_HEALTH_TOKEN=replace-with-the-egress-health-token
AIBRAIN_ALERT_ALLOW_COMPOSE_READINESS=1
AIBRAIN_REPLICA_STATE_ROOT=/var/lib/aibrain-replication
AIBRAIN_ALERT_RESTART_COUNT_15M=0
AIBRAIN_ALERT_PREFLIGHT_FAILURE_COUNT_15M=0
