[Unit]
Description=Arnall Windows document synchronization to Hetzner
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=3600
StartLimitBurst=6

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/aibrain/rdp-sync.py --manifest /etc/aibrain/company-qa/rdp/sync.json
TimeoutStartSec=1800
TimeoutStopSec=15
KillMode=control-group
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=78
Nice=10
MemoryMax=1G
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/aibrain/rdp-sync/arnall /var/lib/aibrain/rdp-imports/arnall
# Only scoped, manifest-bound directories are ever published below this tree.
ReadWritePaths=/var/lib/docker/volumes/aibrain-company-qa-data/_data/enterprise-documents
