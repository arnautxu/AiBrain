# Secret per-installation egress policy. Install as mode 0600 outside the repository.
# Generate each value independently: openssl rand -hex 48
AIBRAIN_EGRESS_BROWSER_TOKEN=replace-with-independent-random-browser-token
AIBRAIN_EGRESS_WORKER_TOKEN=replace-with-independent-random-worker-token
AIBRAIN_EGRESS_SERVER_TOKEN=replace-with-independent-random-server-token

# Exact lowercase DNS hostnames only; no wildcards or URL paths.
# Keep this to the minimum Codex/App Server endpoints proven necessary in QA.
AIBRAIN_EGRESS_WORKER_HOSTS=api.openai.com

# Exact credential-free HTTPS origin, default port only.
AIBRAIN_EGRESS_SUPABASE_ORIGIN=https://project-ref.supabase.co

# Operational bounds. Do not increase before measuring the installation.
AIBRAIN_EGRESS_MAX_HEADER_BYTES=32768
AIBRAIN_EGRESS_MAX_CONNECTIONS=128
AIBRAIN_EGRESS_MAX_ADDRESSES=16
AIBRAIN_EGRESS_CONNECT_TIMEOUT_MS=10000
AIBRAIN_EGRESS_IDLE_TIMEOUT_MS=60000
AIBRAIN_EGRESS_REQUEST_TIMEOUT_MS=120000
AIBRAIN_EGRESS_MAX_BYTES=134217728
