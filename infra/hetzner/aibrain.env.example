# Runtime-only values. Copy outside the checkout and chmod 0600.
NODE_ENV=production
AIBRAIN_AUTH_MODE=supabase
AIBRAIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
AIBRAIN_AUTH_CHALLENGE_SECRET=replace-with-an-independent-32-byte-secret
AIBRAIN_PUBLICATION_SECRET=replace-with-an-independent-32-byte-secret
AIBRAIN_BROWSER_GATEWAY_SECRET=replace-with-an-independent-32-byte-secret
AIBRAIN_MAINTENANCE_SECRET=replace-with-an-independent-operator-32-byte-secret
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Temporary QA-only subscription sharing. Keep per-user CODEX_HOME, workspace,
# staging and audit roots; only auth.json is copied from this private canonical
# source when a worker starts. Leave both values unset for per-user auth.
# AIBRAIN_CODEX_AUTH_SCOPE=shared-qa
# AIBRAIN_SHARED_CODEX_AUTH_SOURCE=/var/lib/aibrain/data/runtime/shared-codex-auth/auth.json

# Determine this exact value from the immutable image before first start.
AIBRAIN_CHROME_EXPECTED_VERSION=000.0.0000.0

# Readiness fails at 80% used or under 1 GiB free, whichever is stricter.
AIBRAIN_MINIMUM_FREE_RATIO=0.20
AIBRAIN_MINIMUM_FREE_BYTES=1073741824

# Saturation controls protect the host; they are not commercial user quotas.
AIBRAIN_BROWSER_MAX_CONCURRENT_STARTS=2
AIBRAIN_BROWSER_MAX_PENDING_STARTS=20
AIBRAIN_BROWSER_TOOL_MAX_RECORDS=100000
AIBRAIN_BROWSER_TOOL_MAX_BYTES=2147483648
AIBRAIN_DOCUMENT_MAX_CONVERSIONS=2
AIBRAIN_DOCUMENT_RETRY_AFTER_MS=1000
AIBRAIN_DOCUMENT_MAX_ACTIVE_UPLOADS=2
AIBRAIN_DOCUMENT_WORST_CASE_ACTIVE_BYTES=536870912
AIBRAIN_DOCUMENT_STORAGE_RETRY_AFTER_MS=5000
AIBRAIN_DOCUMENT_TEMP_GRACE_MS=21600000
AIBRAIN_PUBLICATION_CANDIDATE_RETENTION_MS=2592000000
