# Use "demo" only for local UI/runtime validation. Production fails closed
# unless this is explicitly set to "supabase" with all public values below.
AIBRAIN_AUTH_MODE=demo
# Versioned, non-secret installation identity, branding and filesystem layout.
# Production requires an absolute path. Development defaults to the synthetic fixture.
# AIBRAIN_INSTALLATION_CONFIG=/absolute/path/to/installation.json
# Optional UX review gate. It is accepted only when VERCEL_ENV=preview; it can
# never enable demo auth on a Vercel production deployment.
# AIBRAIN_ENABLE_PREVIEW_DEMO=1
# Used for opaque Codex thread tokens in every auth mode. Never commit a real value.
AIBRAIN_SESSION_SECRET=replace-with-a-long-random-local-secret
# Canonical HTTPS origin used in email redirects and invitations.
# AIBRAIN_PUBLIC_URL=https://brain.example.com

# Production identity only. Use the new sb_publishable_ key.
# NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Demo-only manifest overlays. Use /tmp for an ephemeral Vercel preview.
# Supabase mode never falls back to this directory.
CONTROL_PLANE_DATA_DIR=/var/lib/aibrain/control-plane

CHAT_RUNTIME=codex
CODEX_BIN=codex
CODEX_HOME_ROOT=/var/lib/aibrain/codex
CODEX_WORKSPACE_ROOT=/var/lib/aibrain/workspaces
# Optional: let Codex use the subscription's default model.
# CODEX_MODEL=
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX=workspace-write
