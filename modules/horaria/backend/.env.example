# AiBrain service: private database and service volume; no standalone login/UI.
HORARIA_INSTALLATION_ID=
HORARIA_BRIDGE_SECRET=
HORARIA_STATE_ROOT=/var/lib/horaria
HOST=127.0.0.1
# Explicit activation only after installation acceptance.
HORARIA_ALLOW_AI=0
HORARIA_CODEX_URL=http://app:3000
HORARIA_ALLOW_DELIVERY=0
HORARIA_ALLOW_AUTOMATIC=0
HORARIA_PUBLIC_WEBHOOK_URL=https://arnall.graphikai.com/api/horaria-events/webhook
# Required only for 360dialog authenticated webhook transport.
HORARIA_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Còpia aquest fitxer a `.env` i omple els valors.
#
# `.env` NO va al git i no ha d'anar-hi mai: porta la contrasenya de la base de
# dades i els tokens de WhatsApp. Per muntar un ordinador nou, els valors es
# copien des del Render (Environment) o des del `.env` de l'ordinador que ja
# funciona — no des d'aquí.
#
# Els que porten (opcional) tenen un valor per defecte raonable i es poden
# deixar buits per començar.
# ─────────────────────────────────────────────

# ── Imprescindibles ──────────────────────────
# La base de dades. Al Neon és la cadena "pooled" del panell.
DATABASE_URL=postgresql://usuari:contrasenya@servidor/basededades?sslmode=require
# Qualsevol text llarg i secret: signa les sessions. Si canvia, tothom ha de tornar a entrar.
JWT_SECRET=
# La IA utilitza el Codex connectat a AiBrain; no cal cap clau Anthropic.

# ── WhatsApp (Meta Cloud API) ────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WABA vinculat al número; es comprova a cada webhook de Meta.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# El que es diu a Meta en configurar el webhook; ha de coincidir exactament.
WHATSAPP_VERIFY_TOKEN=
# Per comprovar que els missatges entrants vénen de Meta de debò.
META_APP_SECRET=
# Plantilles aprovades. Sense aquestes, només es pot escriure a qui hagi
# escrit en les últimes 24h.
WHATSAPP_TEMPLATE_BROADCAST=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_HORARIO=
WHATSAPP_TEMPLATE_MANAGER_REMINDER=
WHATSAPP_TEMPLATE_LANG=es
# (opcional) L'identificador antic del número; val com a sinònim de
# WHATSAPP_PHONE_NUMBER_ID si el codi no troba aquell.
WHATSAPP_PHONE_ID=
# (opcional) Qui envia els missatges: 'twilio' o 'd360' en comptes de Meta.
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# (opcional) 360dialog, l'altra alternativa a Meta.
D360_API_KEY=
D360_BASE_URL=
# (opcional) 'true' per provar sense enviar cap missatge de veritat.
WHATSAPP_MOCK=

# ── Notes de veu ─────────────────────────────
# (opcional) Sense això, les notes de veu no es transcriuen.
DEEPGRAM_API_KEY=

# ── Servidor ─────────────────────────────────
PORT=3210
NODE_ENV=development
# L'adreça pública, per als enllaços dels PDF que s'envien per WhatsApp.
PUBLIC_BASE_URL=https://arnall.graphikai.com
# (opcional) D'on s'accepten peticions, separades per comes.
ALLOWED_ORIGINS=
# El servidor va en UTC a posta: hi ha dates que es calculen amb l'hora local.
TZ=Europe/Madrid
# (opcional) El secret que protegeix les crides automàtiques setmanals.
WEEKLY_REMINDER_SECRET=

# ── Còpies i dades personals ─────────────────
# (opcional) On es desen les còpies. Per defecte, ../backups
BACKUP_DIR=
# (opcional) Quantes se'n guarden.
BACKUP_KEEP=
# (opcional) Mesos que es guarden converses i fulls abans d'esborrar-los.
RETENTION_MONTHS=
