        "rateLimitsAvailable": { "type": "boolean" },
        "accountTokenUsageAvailable": { "type": "boolean" },
        "rateLimits": { "type": "array", "items": { "type": "object" } },
        "accountTokenUsage": { "type": ["object", "null"] }
      }
    },
    "PersonalUsageResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scope", "generatedAt", "userId", "internal", "sharedSubscription", "notices"],
      "properties": {
