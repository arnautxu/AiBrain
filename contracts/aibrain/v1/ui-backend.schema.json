      "properties": {
        "healthy": { "type": "boolean" },
        "state": {
          "type": "object",
          "required": ["schemaVersion", "installationId", "userId", "browserSessionId", "lifecycle", "controller", "generation", "downloads", "createdAt", "updatedAt"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "installationId": { "type": "string" },
            "userId": { "type": "string" },
            "browserSessionId": { "type": ["string", "null"] },
            "lifecycle": { "enum": ["stopped", "starting", "ready", "human-control", "recovering", "degraded"] },
            "controller": { "enum": ["none", "agent", "human"] },
            "generation": { "type": "integer", "minimum": 0 },
            "downloads": { "type": "array" },
            "createdAt": { "$ref": "#/$defs/IsoDate" },
            "updatedAt": { "$ref": "#/$defs/IsoDate" }
          }
        },
        "runtime": { "type": ["object", "null"] },
        "runningInProcess": { "type": "boolean" }
      }
    }
