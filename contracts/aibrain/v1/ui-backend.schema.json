        "sharedSubscription": { "$ref": "#/$defs/SharedSubscriptionSnapshot" },
        "notices": { "type": "array", "items": { "type": "string" } }
      }
    },
    "CompanyUsageResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scope", "generatedAt", "installationId", "internal", "members", "sharedSubscription", "notices"],
      "properties": {
