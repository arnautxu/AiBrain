        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userId", "displayName", "email", "usage"],
            "properties": {
              "userId": { "$ref": "#/$defs/Uuid" },
              "displayName": { "type": "string", "minLength": 1 },
              "email": { "type": "string", "minLength": 3 },
              "usage": { "$ref": "#/$defs/UsageAggregate" }
            }
          }
        },
        "sharedSubscription": { "$ref": "#/$defs/SharedSubscriptionSnapshot" },
        "notices": { "type": "array", "items": { "type": "string" } }
      }
    },
    "TeamResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "members"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userId", "displayName", "email", "workerId"],
            "properties": {
              "userId": { "$ref": "#/$defs/Uuid" },
              "displayName": { "type": "string", "minLength": 1 },
              "email": { "type": "string", "minLength": 3 },
              "workerId": { "type": "string", "minLength": 2 }
            }
          }
        }
      }
    },
    "BrowserStatus": {
      "type": "object",
      "additionalProperties": false,
