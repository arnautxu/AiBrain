{
  "name": "aibrain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit src",
    "test:integration": "vitest run tests/integration",
    "test:documents:real": "AIBRAIN_REAL_DOCUMENT_MATRIX=1 vitest run tests/integration/document-preview.integration.test.ts",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "contracts:generate": "npm exec --yes --package=@openai/codex@0.149.1 -- codex app-server generate-ts --experimental --out contracts/codex/0.149.1/types && npm exec --yes --package=@openai/codex@0.149.1 -- codex app-server generate-json-schema --experimental --out contracts/codex/0.149.1/schema",
    "installation:new": "node scripts/create-installation.mjs",
    "users:provision": "tsx scripts/provision-users.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.112.4",
    "ajv": "8.20.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "6.0.2",
    "vitest": "^4.1.11"
  }
}
