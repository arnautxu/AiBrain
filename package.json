{
  "name": "aibrain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:automation-worker": "node scripts/build-automation-worker.mjs",
    "build:container-app-server-acceptance": "node scripts/build-container-app-server-acceptance.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit src",
    "test:component": "vitest run tests/component",
    "test:adapter": "vitest run tests/unit/app-server-ui-adapter.test.ts tests/unit/durable-chat-event-adapter.test.ts tests/unit/frame-event-dispatcher.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:documents:real": "AIBRAIN_REAL_DOCUMENT_MATRIX=1 vitest run tests/integration/document-preview.integration.test.ts tests/integration/local-document-workflow.integration.test.ts",
    "test:browser:real": "AIBRAIN_REAL_CHROME_TEST=1 vitest run src/runtime/browser/chrome-runtime.real.test.ts",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "npm run test:e2e:backend && npm run test:e2e:ui",
    "test:e2e:backend": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:ui": "playwright test --project=chromium-desktop",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile --project=visual-matrix",
    "test:a11y": "playwright test --project=accessibility",
    "acceptance:verify": "tsx scripts/verify-live-acceptance.ts",
    "acceptance:release-evidence": "tsx scripts/create-predeploy-release-evidence.ts",
    "acceptance:collect-release-readbacks": "node --experimental-strip-types scripts/collect-release-readbacks.ts",
    "acceptance:automations-offline": "node --import ./scripts/register-server-only-stub.mjs --import tsx scripts/verify-automation-worker-offline.ts",
    "test:soak": "tsx scripts/soak.ts",
    "test:soak:qa": "tsx scripts/soak.ts --qa",
    "test:coverage": "vitest run --coverage",
    "benchmark:chat": "tsx scripts/benchmark-chat-client.ts",
    "benchmark:chat:runtime": "node scripts/benchmark-chat-runtime.mjs",
    "contracts:generate": "npm exec --yes --package=@openai/codex@0.149.1 -- codex app-server generate-ts --experimental --out contracts/codex/0.149.1/types && npm exec --yes --package=@openai/codex@0.149.1 -- codex app-server generate-json-schema --experimental --out contracts/codex/0.149.1/schema",
    "contracts:verify": "node scripts/verify-codex-contracts.mjs",
    "installation:new": "node scripts/create-installation.mjs",
    "company-context:seed": "tsx scripts/seed-company-context.ts",
    "users:provision": "tsx scripts/provision-users.ts",
    "users:manage": "tsx scripts/manage-users.ts",
    "connectors:preflight": "tsx scripts/connector-preflight.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:replicate": "tsx scripts/replicate-backup.ts",
    "backup:evidence": "tsx scripts/check-backup-evidence.ts",
    "backup:orchestrate": "node scripts/orchestrate-backup.mjs",
    "documents:maintain": "tsx scripts/maintain-document-temporaries.ts",
    "workbench:rebuild-shared-access": "tsx scripts/rebuild-shared-access-index.ts",
    "alerts:run": "tsx scripts/run-operational-alerts.ts",
    "automations:worker": "tsx scripts/run-automations.ts",
    "automations:once": "tsx scripts/run-automations.ts --once",
    "infra:validate": "node scripts/validate-infra.mjs",
    "infra:preflight": "node scripts/validate-host-preflight.mjs",
    "release:manage": "node scripts/manage-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@remixicon/react": "^4.9.0",
    "@supabase/supabase-js": "2.112.4",
    "ajv": "8.20.0",
    "busboy": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "js-yaml": "4.3.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "^2.17.5",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1",
    "tw-shimmer": "^0.4.12",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/busboy": "1.5.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
